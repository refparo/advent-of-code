import Std.Data.HashMap

import AdventOfCode.Utils

namespace Prod

  @[inline]
  def turnRight : Offset × Offset -> Offset × Offset
  | (di, dj) => (dj, -di)

  @[inline]
  def turnLeft : Offset × Offset -> Offset × Offset
  | (di, dj) => (-dj, di)

end Prod

namespace Day6

open Std (HashMap)

inductive Tile
| space
| obstruction
| path (step : Nat)
deriving Inhabited, BEq

open Tile

instance : ToString Tile where
  toString := fun
  | space => "."
  | path _ => "X"
  | obstruction => "#"

def parseInput (input : String) :=
  let (mat, guard) := StateT.run (m := Id) (s := Option.none)
    $ Matrix.parseM! input fun (i, j) c => do
      match c with
      | '.' => return space
      | '#' => return obstruction
      | '^' =>
        StateT.set (.some (i, j))
        return space
      | _ => panic "invalid input"
  (mat, guard.get!)

def solvePart1 (mat : Matrix Tile) (guard : Nat × Nat) := Id.run do
  let mut mat := mat
  let borders := ([:mat.height], [:mat.width]) + 1
  let mut pos := guard + 1n
  let mut dir : Offset × Offset := (-1, 0)
  let mut step := 0
  while pos ∈ borders do
    match mat[pos - 1n]! with
    | space =>
      mat := mat.set! (pos - 1n) $ path step
      step := step + 1
    | obstruction =>
      pos := pos - dir
      dir := dir.turnRight
    | path _ => ()
    pos := pos + dir
  (step, mat)

