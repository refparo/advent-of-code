import Std.Data.HashSet

import AdventOfCode.Utils

namespace Day6

open Std (HashSet)

inductive Tile
| space
| obstruction
| path (step : Nat)
deriving Inhabited, BEq

open Tile

instance : ToString Tile where
  toString := fun
  | space => "."
  | path _ => "X"
  | obstruction => "#"

def parseInput (input : String) :=
  let (mat, guard) := StateT.run (m := Id) (s := Option.none)
    $ Matrix.parseM! input fun pos c => do
      match c with
      | '.' => return space
      | '#' => return obstruction
      | '^' =>
        StateT.set (.some pos)
        return space
      | _ => panic "invalid input"
  (mat, guard.get!)

def walk (mat : Matrix Tile) (guard : Nat × Nat) := Id.run do
  let mut mat := mat
  let borders := ([:mat.height], [:mat.width]) + 1
  let mut pos := guard + 1n
  let mut dir : Offset × Offset := (-1, 0)
  let mut turns := HashSet.empty
  let mut step := 0
  while pos ∈ borders do
    match mat[pos - 1n]! with
    | space =>
      mat := mat.set! (pos - 1n) $ path step
      step := step + 1
    | obstruction =>
      pos := pos - dir
      if (pos, dir) ∈ turns
      then return Option.none
      else turns := turns.insert (pos, dir)
      dir := dir.turnRight
    | path _ => ()
    pos := pos + dir
  Option.some step

def makeLoop (mat : Matrix Tile) (guard : Nat × Nat) :=
  List.range mat.height
  |>.map (
    fun i => List.range mat.width
    |>.countP (
      fun j => mat[(i, j)]! == space && (walk (mat.set! (i, j) obstruction) guard).isNone
    )
  )
  |>.sum

