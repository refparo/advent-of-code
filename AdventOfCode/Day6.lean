import Std.Data.HashMap

import AdventOfCode.Utils

namespace Prod

  @[inline]
  def turnRight : Offset × Offset -> Offset × Offset
  | (di, dj) => (dj, -di)

  @[inline]
  def turnLeft : Offset × Offset -> Offset × Offset
  | (di, dj) => (-dj, di)

end Prod

namespace Day6

open Std (HashMap)

inductive Tile
| space
| obstruction
| path (step : Nat)
deriving Inhabited, BEq

open Tile

instance : ToString Tile where
  toString := fun
  | space => "."
  | path _ => "X"
  | obstruction => "#"

def parseInput (input : String) := Id.run do
  let mut mat := Array.empty
  let mut width := Option.none
  let mut guard := Option.none
  let mut (i, j) := (0, 0)
  for char in input.toSubstring do
    match char with
    | '.' =>
      mat := mat.push space
      j := j + 1
    | '#' =>
      mat := mat.push obstruction
      j := j + 1
    | '^' =>
      guard := .some (i, j)
      mat := mat.push space
      j := j + 1
    | '\n' =>
      width := .some j
      i := i + 1
      j := 0
    | _ => panic "invalid input"
  (Matrix.mk mat width.get!, guard.get!)

def solvePart1 (mat : Matrix Tile) (guard : Nat × Nat) := Id.run do
  let mut mat := mat
  let borders := ([:mat.height], [:mat.width]) + 1
  let mut pos := guard + (1 : Nat)
  let mut dir : Offset × Offset := (-1, 0)
  let mut step := 0
  while pos ∈ borders do
    match mat[pos - (1 : Nat)]! with
    | space =>
      mat := mat.set! (pos - (1 : Nat)) $ path step
      step := step + 1
    | obstruction =>
      pos := pos - dir
      dir := dir.turnRight
    | path _ => ()
    pos := pos + dir
  (step, mat)

