partial def trace (mat : Matrix Bool) (start : Nat × Nat) := go
where
  bounds := mat.bounds
  go
    (path : Matrix Nat := { mat with array := Array.mkArray mat.array.size 0 })
    (dist : Nat := 1)
    (pos : Nat × Nat := start)
  :=
    let path := path.set! pos dist
    let dist := dist + 1
    if let .some pos := dirs.findSome? fun (dir : Offset × Offset) =>
      let pos' := pos + dir
      if pos' ∈ bounds && ! mat[pos']! && path[pos']! == 0
      then .some pos'
      else .none
    then go path dist pos
    else path

def solvePart1 (path : Matrix Nat) (p : Nat -> Bool := (· >= 100)) :=
  (0, path.height).foldI (a := 0) fun i count =>
    (0, path.width).foldI (a := count) fun j count =>
      dirs'.foldl (init := count) fun count (dir : Offset × Offset) =>
        Id.run do
          let pos := (i, j)
          let dist := path[pos]!
          if dist > 0 then
            let pos' := pos + dir
            if pos' ∈ bounds then
              let dist' := path[pos']!
              if p $ dist' - dist - 2 then
                return count + 1
          return count
where
  bounds := path.bounds
  dirs' := [
    (-2, 0), (-1, -1), (-1o, 1o),
    (0, -2), (0, 2),
    (1, -1), (1, 1), (2, 0)
  ]

def solvePart2 (path : Matrix Nat)
  (maxCheat : Nat := 20) (minSaving : Nat := 100)
:=
  let steps := (0, path.height).foldI (a := #[]) fun i steps =>
    (0, path.width).foldI (a := steps) fun j steps =>
      let dist := path[(i, j)]!
      if dist > 0 then steps.push (dist - 1, i, j)
      else steps
  let steps := steps.qsort (·.fst < ·.fst)
  steps.foldl (init := 0) fun count (step, i, j) =>
    steps[step + minSaving:].foldl (init := count) fun count (step', i', j') =>
      let cheatLength := (i'.offset i).natAbs + (j'.offset j).natAbs
      if cheatLength <= maxCheat &&
        step + cheatLength <= step' - minSaving
      then count + 1
      else count

