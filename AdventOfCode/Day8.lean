import Std.Data.HashMap
import Std.Data.HashSet

import AdventOfCode.Utils

namespace Day8

open Std (HashMap HashSet Range)

def parseInput (input : String) :=
  let (mat, result) :=
    StateT.run (m := Id) (s := HashMap.empty)
    $ Matrix.parseM! input fun pos c =>
      if c != '.' then
        modify fun freqs =>
          freqs.alter c fun antennas =>
            .some $ (antennas.getD #[]).push pos
      else pure ()
  (result, mat.bounds)

@[specialize]
def antinodes
  (bounds : Range × Range)
  (unlimited : Bool := false)
  (output : HashSet (Nat × Nat) := HashSet.empty)
  (antennas : Array (Nat × Nat))
:= Id.run do
  let bounds := bounds + 1
  let mut output := output
  for (i, j) in antennas[1:], k in [1:] do
    for (i', j') in antennas[:k] do
      let dist := (i.offset i', j.offset j')
      let mut a := (i, j) + 1n + if unlimited then (0, 0) else dist
      while a ∈ bounds do
        output := output.insert (a - 1n)
        if unlimited then a := a + dist
        else break
      a := (i', j') + 1n - if unlimited then (0, 0) else dist
      while a ∈ bounds do
        output := output.insert (a - 1n)
        if unlimited then a := a - dist
        else break
  output

def solve
  (antennas : HashMap Char (Array (Nat × Nat)))
  (bounds : Range × Range)
  (unlimited : Bool := false)
:= antennas.values
  |>.foldl (init := HashSet.empty) (antinodes bounds unlimited · ·)
  |>.size

