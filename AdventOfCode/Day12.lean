import Std.Data.HashMap

import AdventOfCode.Utils

namespace Day12

open Std (HashMap Queue)

def parseInput := Matrix.parse! (f := fun _ c => c)

def dirs := [(-1o, 0), (0, -1o), (1, 0), (0, 1)]

def valuateRegion
  (mat : Matrix Char)
  (start : Nat × Nat)
  (done : Matrix Bool := Matrix.mk (Array.mkArray mat.array.size false) mat.width)
:= Id.run do
  let bounds := mat.bounds + 1n
  let mut done := done
  let mut todo := Queue.empty.enqueue (start + 1n)
  let plant := mat[start]!
  let mut area := 0
  let mut perimeter := 0
  while true do
    let .some (pos, rest) := todo.dequeue? | break
    todo := rest
    if pos ∈ bounds && mat[pos - 1n]! == plant then
      if ! done[pos - 1n]! then
        done := done.set! (pos - 1n) true
        area := area + 1
        for dir in dirs do
          todo := todo.enqueue (pos + dir)
    else
      perimeter := perimeter + 1
  (area * perimeter, done)

def joinSides
  (sides : HashMap (Offset × Offset) (Array ((Nat × Nat) × (Nat × Nat))))
  (side : (Nat × Nat) × (Offset × Offset))
:=
  let ((i, j), (di, dj)) := side
  let key := (di * i, dj * j)
  match sides.get? key with
  | .none => sides.insert key #[((i, j), (i, j))]
  | .some arr =>
    let left := arr.find? fun ((i', j'), _) =>
      i'.offset i == 1 || j'.offset j == 1
    let right := arr.find? fun (_, (i', j')) =>
      i'.offset i == -1 || j'.offset j == -1
    let arr := match (left, right) with
      | (.none, .none) => arr.push ((i, j), (i, j))
      | (.some left@(_, (i', j')), .none) =>
        arr.erase left |>.push ((i, j), (i', j'))
      | (.none, .some right@((i', j'), _)) =>
        arr.erase right |>.push ((i', j'), (i, j))
      | (.some left@(_, (i', j')), .some right@((i'', j''), _)) =>
        arr.erase left |>.erase right |>.push ((i'', j''), (i', j'))
    sides.insert key arr

def valuateWithDiscount
  (mat : Matrix Char)
  (start : Nat × Nat)
  (done : Matrix Bool := Matrix.mk (Array.mkArray mat.array.size false) mat.width)
:= Id.run do
  let bounds := mat.bounds + 1n
  let mut done := done
  let mut todo := Queue.empty.enqueue (start + 1n, dirs.head (by trivial))
  let plant := mat[start]!
  let mut area := 0
  let mut sides := HashMap.empty
  while true do
    let .some ((pos, dir), rest) := todo.dequeue? | break
    todo := rest
    if pos ∈ bounds && mat[pos - 1n]! == plant then
      if ! done[pos - 1n]! then
        done := done.set! (pos - 1n) true
        area := area + 1
        for dir in dirs do
          todo := todo.enqueue (pos + dir, dir)
    else
      sides := joinSides sides (pos - dir, dir)
  (area * (sides.values.map (·.size) |>.sum), done)

def valuateAll
  (evaluateRegion : Matrix Char -> Nat × Nat -> Matrix Bool -> Nat × Matrix Bool)
  (mat : Matrix Char)
:= Id.run do
  let mut done := Matrix.mk (Array.mkArray mat.array.size false) mat.width
  let mut total := 0
  while true do
    let .some i := done.array.findIdx? (!·) | break
    let start := (i / done.width, i % done.width)
    let (price, newDone) := evaluateRegion mat start done
    total := total + price
    done := newDone
  total

