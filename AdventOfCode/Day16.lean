import AdventOfCode.Utils

namespace Day16

open Std (Queue)

instance : ToString Bool where
  toString
  | true => "#"
  | false => "."

def parseInput (input : String) :=
  let ((mat, start), stop) :=
    StateT.run (m := Id) (s := Option.none)
    $ StateT.run (s := Option.none)
      $ Matrix.parseM! input fun (i, j) => fun
        | '#' => pure true
        | '.' => pure false
        | 'S' => do
          StateT.set $ .some (i, j)
          pure false
        | 'E' => do
          StateT.lift $ StateT.set $ .some (i, j)
          pure false
        | _ => panic!"illegal input"
  (mat, start.get!, stop.get!)

def turnScore (dir dir' : Offset × Offset) :=
  match dir.dot dir' with
  | 1 => 0
  | 0 => 1000
  | -1 => 2000
  | _ => panic!"impossible"

def findPath (mat : Matrix Bool) (start : Nat × Nat) (stop : Nat × Nat)
:= Id.run do
  let mut minScore := { mat with array := Array.mkArray mat.array.size [] }
  let mut bestScore := Option.none
  let mut todo := Queue.empty.enqueue (0, (0, 1), start)
  repeat do
    let .some ((score', dir', pos), rest) := todo.dequeue? | break
    todo := rest
    if pos == stop then
      bestScore := .some $ min score' $ bestScore.getD score'
      continue
    else if bestScore.map (decide $ · <= score') == .some true then
      continue
    let mut minScore' := dirs.map (score' + turnScore dir' ·)
    let better <-
      if minScore[pos]! == [] then true else
        minScore' := minScore'.zipWith min minScore[pos]!
        minScore' != minScore[pos]!
    if better then
      minScore := minScore.set! pos minScore'
      for dir in dirs do
        if ! mat[pos + dir]! then
          todo := todo.enqueue (score' + turnScore dir dir' + 1, dir, pos + dir)
  (bestScore.get!, minScore)

def findBackwards (mat : Matrix Bool) (stop : Nat × Nat)
  (bestScore : Nat) (minScore : Matrix (List Nat))
:= Id.run do
  let mut done := { mat with array := Array.mkArray mat.array.size false }
  let mut step := 0
  let mut todo := Queue.empty.enqueueAll [
    (bestScore, stop),
    (bestScore, stop),
  ]
  repeat do
    let .some ((score', pos'), rest) := todo.dequeue? | break
    todo := rest
    if ! done[pos']! then
      done := done.set! pos' true
      step := step + 1
    for dir' in dirs do
      let pos := pos' - dir'
      if ! mat[pos]! then
        for score in minScore[pos]!, dir in dirs do
          if score + turnScore dir dir' + 1 == score' then
            todo := todo.enqueue (score, pos)
  step

