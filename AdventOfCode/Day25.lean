import AdventOfCode.Utils

namespace Day25

def parseInput (input : String) :=
  input.toSubstring.splitOn "\n\n" |>.partitionMap fun str =>
    let top := str.front
    (if top == '#' then Sum.inl else .inr)
    $ Prod.snd $ str.splitOn "\n" |>.tail.take 5
    |>.foldl (init := (0, #[5, 5, 5, 5, 5])) fun (i, arr) line => (i + 1,
      Prod.snd $ line.foldl (init := (0, arr)) fun (j, arr) c => (j + 1,
        if c != top
        then arr.modify j fun h => if h == 5 then i else h
        else arr
      )
    )

def tryEachPair (locks keys : List (Array Nat)) :=
  locks.foldl (init := 0) fun acc lock =>
    acc + keys.countP fun key =>
      lock.zipWith key (decide $ · <= ·) |>.all (·)

